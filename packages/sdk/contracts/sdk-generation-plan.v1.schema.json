{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:sdk:generation-plan:v1",
  "title": "SDK generation plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_contract_version",
    "source_contract",
    "source_contract_version",
    "input_hash_algorithm",
    "language_set",
    "generator",
    "generator_version",
    "output_root",
    "package_registry",
    "stages",
    "compatibility_required",
    "rollback_rule",
    "decision_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pipeline_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_contract": {
      "const": "docs/contracts/openapi/openapi.yaml"
    },
    "source_contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "input_hash_algorithm": {
      "const": "SHA256"
    },
    "language_set": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "generator": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "generator_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "output_root": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "package_registry": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "enabled",
          "status",
          "blocked_by"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "blocked_by": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "compatibility_required": {
      "const": true
    },
    "rollback_rule": {
      "type": "string",
      "minLength": 1
    },
    "decision_status": {
      "const": "TBD-007"
    }
  },
  "additionalProperties": false
}
