{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:operations:ownership-record:v1",
  "title": "Component ownership record v1",
  "type": "object",
  "required": [
    "component_id",
    "component_kind",
    "component_path",
    "owner_ref",
    "owner_status",
    "slo_ref",
    "runbook_ref",
    "upgrade_window_ref",
    "data_retention_responsibility_ref"
  ],
  "properties": {
    "component_id": { "type": "string", "minLength": 1 },
    "component_kind": { "type": "string", "enum": ["application", "shared_package"] },
    "component_path": { "type": "string", "pattern": "^(apps|packages)/[a-z0-9-]+$" },
    "owner_ref": { "type": ["string", "null"], "minLength": 1 },
    "owner_status": { "const": "TBD-018" },
    "slo_ref": { "type": ["string", "null"], "minLength": 1 },
    "runbook_ref": { "type": ["string", "null"], "minLength": 1 },
    "upgrade_window_ref": { "type": ["string", "null"], "minLength": 1 },
    "data_retention_responsibility_ref": { "type": ["string", "null"], "minLength": 1 }
  },
  "additionalProperties": false
}
