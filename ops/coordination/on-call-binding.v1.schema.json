{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:operations:on-call-binding:v1",
  "title": "On-call binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "status", "version", "created_at", "updated_at",
    "created_by", "updated_by", "tenant_id", "revision", "effective_at",
    "rollback_revision", "content_hash", "component_ref", "owner_ref",
    "provider_adapter_ref", "schedule_ref", "escalation_policy_ref",
    "contact_target_ref", "decision_status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "updated_by": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 },
    "effective_at": { "type": ["string", "null"], "format": "date-time" },
    "rollback_revision": { "type": ["integer", "null"], "minimum": 1 },
    "content_hash": { "type": ["string", "null"] },
    "component_ref": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": ["string", "null"] },
    "provider_adapter_ref": { "type": ["string", "null"] },
    "schedule_ref": { "type": ["string", "null"] },
    "escalation_policy_ref": { "type": ["string", "null"] },
    "contact_target_ref": { "type": ["string", "null"] },
    "decision_status": { "const": "TBD-020" }
  }
}
