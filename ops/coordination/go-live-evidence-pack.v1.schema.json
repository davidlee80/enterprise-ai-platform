{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:operations:go-live-evidence-pack:v1",
  "title": "Go-live evidence pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_pack_id", "change_ref", "test_results_ref",
    "security_scan_ref", "security_approval_ref", "configuration_version_ref",
    "deployment_record_ref", "migration_result_ref", "slo_smoke_result_ref",
    "capacity_result_ref", "observability_result_ref", "runbook_ref",
    "rollback_plan_ref", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_pack_id": { "type": "string", "minLength": 1 },
    "change_ref": { "type": "string", "minLength": 1 },
    "test_results_ref": { "type": "string", "minLength": 1 },
    "security_scan_ref": { "type": "string", "minLength": 1 },
    "security_approval_ref": { "type": "string", "minLength": 1 },
    "configuration_version_ref": { "type": "string", "minLength": 1 },
    "deployment_record_ref": { "type": "string", "minLength": 1 },
    "migration_result_ref": { "type": "string", "minLength": 1 },
    "slo_smoke_result_ref": { "type": "string", "minLength": 1 },
    "capacity_result_ref": { "type": "string", "minLength": 1 },
    "observability_result_ref": { "type": "string", "minLength": 1 },
    "runbook_ref": { "type": "string", "minLength": 1 },
    "rollback_plan_ref": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
