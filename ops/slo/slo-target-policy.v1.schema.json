{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:ops:slo-target-policy:v1",
  "title": "SLO target policy v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "version",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "tenant_id",
    "revision",
    "effective_at",
    "rollback_revision",
    "content_hash",
    "targets",
    "decision_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "updated_by": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rollback_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sli_id",
          "objective",
          "measurement_window",
          "warning_threshold",
          "critical_threshold",
          "error_budget_policy"
        ],
        "properties": {
          "sli_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": [
              "number",
              "null"
            ]
          },
          "measurement_window": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "warning_threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "critical_threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "error_budget_policy": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "decision_status": {
      "const": "TBD-010"
    }
  },
  "additionalProperties": false
}
