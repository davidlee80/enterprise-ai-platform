{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:policy:evaluation-request:v1",
  "title": "Policy Evaluation Request v1",
  "description": "Language-neutral, tenant/version-scoped input assembled from an authenticated principal and published Data Plane policy context.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "tenant_id",
    "config_version",
    "principal",
    "resource",
    "policy_context"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "principal": {
      "type": "object",
      "required": [
        "subject_id",
        "tenant_id",
        "scopes"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "model_alias",
        "region",
        "estimated_cost"
      ],
      "properties": {
        "model_alias": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "estimated_cost": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "policy_context": {
      "type": "object",
      "description": "Published, locally available policy facts; never a synchronous Control Plane database read.",
      "required": [
        "tenant_id",
        "config_version",
        "policy_version",
        "policy_ids",
        "tenant_status",
        "allowed_models",
        "allowed_regions",
        "budget",
        "obligations"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_version": {
          "$ref": "#/$defs/version"
        },
        "policy_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tenant_status": {
          "type": "string",
          "minLength": 1
        },
        "allowed_models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "budget": {
          "type": "object",
          "required": [
            "month_spend",
            "month_limit"
          ],
          "properties": {
            "month_spend": {
              "type": "number",
              "minimum": 0
            },
            "month_limit": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "urn:enterprise-ai-platform:policy:decision:v1#/$defs/obligation"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "version": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  },
  "additionalProperties": false
}
