{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:router:registry:v1",
  "title": "Router Plugin Registry v1",
  "description": "Tenant/version-scoped plugin registration and ordered composition contract.",
  "type": "object",
  "required": ["schema_version", "tenant_id", "config_version", "plugins", "pipelines"],
  "properties": {
    "schema_version": { "const": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "config_version": { "type": "integer", "minimum": 1 },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin_id", "plugin_version", "enabled"],
        "properties": {
          "plugin_id": { "type": "string", "minLength": 1 },
          "plugin_version": { "$ref": "#/$defs/version" },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route_strategy", "plugin_ids"],
        "properties": {
          "route_strategy": { "type": "string", "minLength": 1 },
          "plugin_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "version": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "minLength": 1 }
      ]
    }
  },
  "additionalProperties": false
}
