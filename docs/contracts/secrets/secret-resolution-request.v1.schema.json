{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:secrets:resolution-request:v1",
  "title": "Secret resolution request v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "binding_revision",
    "reference"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "reference": {
      "$ref": "secret-reference.v1.schema.json"
    }
  },
  "additionalProperties": false
}
