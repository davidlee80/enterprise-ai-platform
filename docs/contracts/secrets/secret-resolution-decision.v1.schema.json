{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:secrets:resolution-decision:v1",
  "title": "Secret resolution decision v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "tenant_id",
    "config_version",
    "binding_revision",
    "outcome",
    "reason_code",
    "delivery",
    "audit_outcome",
    "audit_reason_code",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "resolved",
        "denied",
        "unavailable"
      ]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "SECRET_RESOLVED",
        "SECRET_REFERENCE_INVALID",
        "SECRET_TENANT_MISMATCH",
        "SECRET_CONFIG_VERSION_MISMATCH",
        "SECRET_NOT_FOUND",
        "SECRET_ACCESS_DENIED",
        "SECRET_MANAGER_UNAVAILABLE",
        "SECRET_ROTATION_STATE_INVALID",
        "SECRET_BREAK_GLASS_REQUIRED",
        "SECRET_DELIVERY_FAILED"
      ]
    },
    "delivery": {
      "type": "string",
      "enum": [
        "delivered-in-process",
        "not-delivered"
      ]
    },
    "audit_outcome": {
      "type": "string",
      "enum": [
        "enqueued",
        "rejected"
      ]
    },
    "audit_reason_code": {
      "type": "string",
      "enum": [
        "SECRET_AUDIT_EVENT_ENQUEUED",
        "SECRET_AUDIT_EVENT_REJECTED"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
