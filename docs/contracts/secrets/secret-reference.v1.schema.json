{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:secrets:reference:v1",
  "title": "Opaque secret reference v1",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "config_version",
    "purpose",
    "secret_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "description": "Opaque reference. Its syntax and backing product remain TBD-012."
    }
  },
  "additionalProperties": false
}
