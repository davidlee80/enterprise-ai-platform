{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:provider:runtime-config:v1",
  "title": "Provider Runtime Config v1",
  "description": "Internal published Data Plane binding. Endpoint and secret_ref remain inside the adapter infrastructure boundary.",
  "type": "object",
  "required": ["schema_version", "tenant_id", "config_version", "provider_id", "adapter_id", "provider_model", "endpoint", "secret_ref"],
  "properties": {
    "schema_version": { "const": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "config_version": { "type": "integer", "minimum": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "adapter_id": { "type": "string", "minLength": 1 },
    "provider_model": { "type": "string", "minLength": 1, "writeOnly": true },
    "endpoint": { "type": "string", "minLength": 1, "writeOnly": true },
    "secret_ref": { "type": "string", "minLength": 1, "writeOnly": true }
  },
  "additionalProperties": false
}
