  "invariants": [
    "Request completion constructs a UsageObserved event and performs only a non-blocking enqueue before releasing the online response.",
    "Broker publication and Billing consumption run outside the online request lifecycle.",
    "The event, enqueue result, publish result, and consume result carry the same tenant_id, request_id, trace_id, and config_version.",
    "The event contains tenant-visible model alias and opaque Provider identifier only, never endpoint, Provider model, secret_ref, or credential.",
    "Prompt and Response bodies, raw errors, stack traces, and Provider credentials are absent from the event and processing results.",
    "Consumers deduplicate at-least-once delivery by event_id and the tenant-scoped usage_record_id business key.",
    "Duplicate or backlogged events never block or change the already released online response.",
    "Usage aggregation and Billing database writes happen only in asynchronous consumers."
  ],
  "event_type": "UsageObserved",
  "producer": "gateway-data-plane",
  "delivery_contract": "at_least_once_consumer_idempotency_required",
  "online_enqueue_mode": "non_blocking_try_enqueue",
