{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:usage:event:v1",
  "title": "Usage Observed Event v1",
  "description": "Secret-free, asynchronous model request usage observation. It is not a synchronous billing write or final invoice fact.",
  "allOf": [
    { "$ref": "urn:enterprise-ai-platform:event-envelope:v1" },
    {
      "type": "object",
      "required": ["request_id", "trace_id"],
      "properties": {
        "event_type": { "const": "UsageObserved" },
        "schema_version": { "const": 1 },
        "tenant_id": { "type": "string", "format": "uuid" },
        "request_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "producer": { "const": "gateway-data-plane" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "version": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "token_count": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "payload": {
      "type": "object",
      "required": ["usage_record_id", "request_outcome", "final_reason_code", "model_alias", "provider_id", "config_version", "plan_id", "plan_version", "request_started_at", "request_completed_at", "duration_ms", "retry_count", "fallback_count", "fallback_used", "cache_status", "token_usage", "cost"],
      "properties": {
        "usage_record_id": { "type": "string", "format": "uuid" },
        "request_outcome": { "type": "string", "enum": ["succeeded", "failed", "indeterminate"] },
        "final_reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "model_alias": { "type": "string", "minLength": 1 },
        "provider_id": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "config_version": { "type": "integer", "minimum": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "plan_version": { "$ref": "#/$defs/version" },
        "request_started_at": { "type": "string", "format": "date-time" },
        "request_completed_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "fallback_count": { "type": "integer", "minimum": 0 },
        "fallback_used": { "type": "boolean" },
        "cache_status": { "type": "string", "enum": ["not_used", "hit", "miss", "bypassed", "unknown"] },
        "token_usage": {
          "type": "object",
          "required": ["status", "input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "status": { "type": "string", "enum": ["reported", "unavailable"] },
            "input_tokens": { "$ref": "#/$defs/token_count" },
            "output_tokens": { "$ref": "#/$defs/token_count" },
            "total_tokens": { "$ref": "#/$defs/token_count" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "reported" } }, "required": ["status"] },
              "then": {
                "properties": {
                  "input_tokens": { "type": "integer", "minimum": 0 },
                  "output_tokens": { "type": "integer", "minimum": 0 },
                  "total_tokens": { "type": "integer", "minimum": 0 }
                }
              },
              "else": {
                "properties": {
                  "input_tokens": { "type": "null" },
                  "output_tokens": { "type": "null" },
                  "total_tokens": { "type": "null" }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "required": ["status", "amount_decimal", "currency_code", "pricing_version"],
          "properties": {
            "status": { "type": "string", "enum": ["calculated", "not_calculated"] },
            "amount_decimal": {
              "oneOf": [
                { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
                { "type": "null" }
              ]
            },
            "currency_code": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "pricing_version": {
              "oneOf": [
                { "$ref": "#/$defs/version" },
                { "type": "null" }
              ]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "calculated" } }, "required": ["status"] },
              "then": {
                "properties": {
                  "amount_decimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
                  "currency_code": { "type": "string", "minLength": 1 },
                  "pricing_version": { "$ref": "#/$defs/version" }
                }
              },
              "else": {
                "properties": {
                  "amount_decimal": { "type": "null" },
                  "currency_code": { "type": "null" },
                  "pricing_version": { "type": "null" }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
