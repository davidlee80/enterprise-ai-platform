{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:admin-idempotency:decision:v1",
  "title": "Admin write idempotency decision v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "tenant_id",
    "operation_id",
    "config_version",
    "outcome",
    "reason_code",
    "record_version",
    "audit_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "proceed",
        "duplicate",
        "conflict",
        "indeterminate"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "record_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "audit_required": {
      "const": true
    }
  },
  "additionalProperties": false
}
