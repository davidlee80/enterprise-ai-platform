{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-ai-platform:deprecation:policy:v1",
  "title": "Deprecation policy v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "version",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "tenant_id",
    "config_version",
    "revision",
    "effective_at",
    "rollback_revision",
    "content_hash",
    "resource_kind",
    "resource_ref",
    "replacement_ref",
    "announcement_at",
    "window_starts_at",
    "window_ends_at",
    "window_duration",
    "notification_policy_ref",
    "migration_guide_ref",
    "enforcement_after_window_ref",
    "exception_policy_ref",
    "decision_status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "updated_by": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": ["string", "null"], "minLength": 1 },
    "config_version": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "effective_at": { "type": ["string", "null"], "format": "date-time" },
    "rollback_revision": { "type": ["integer", "null"], "minimum": 1 },
    "content_hash": { "type": ["string", "null"], "minLength": 1 },
    "resource_kind": {
      "type": "string",
      "enum": ["api", "model_alias", "config_field", "capability"]
    },
    "resource_ref": { "type": "string", "minLength": 1 },
    "replacement_ref": { "type": ["string", "null"], "minLength": 1 },
    "announcement_at": { "type": ["string", "null"], "format": "date-time" },
    "window_starts_at": { "type": ["string", "null"], "format": "date-time" },
    "window_ends_at": { "type": ["string", "null"], "format": "date-time" },
    "window_duration": { "type": ["string", "null"], "minLength": 1 },
    "notification_policy_ref": { "type": ["string", "null"], "minLength": 1 },
    "migration_guide_ref": { "type": ["string", "null"], "minLength": 1 },
    "enforcement_after_window_ref": { "type": ["string", "null"], "minLength": 1 },
    "exception_policy_ref": { "type": ["string", "null"], "minLength": 1 },
    "decision_status": { "const": "TBD-015" }
  },
  "additionalProperties": false
}
