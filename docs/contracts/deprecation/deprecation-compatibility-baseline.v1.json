    "migration_guide_ref",
    "enforcement_after_window_ref",
    "exception_policy_ref",
    "decision_status"
  ],
  "required_evaluation_fields": [
    "schema_version",
    "evaluation_id",
    "tenant_id",
    "config_version",
    "policy_revision",
    "resource_kind",
