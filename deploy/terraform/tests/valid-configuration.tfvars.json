{
  "configuration": {
    "network": {
      "address_space": "192.0.2.0/24",
      "private_subnet_cidrs": [
        "192.0.2.0/25"
      ]
    },
    "kubernetes": {
      "kubernetes_version": "fixture-version",
      "node_pools": {
        "data-plane": {
          "workload_class": "data-plane",
          "minimum_size": 0,
          "maximum_size": 3,
          "labels": {
            "fixture.platform.example/workload": "data-plane"
          },
          "taints": []
        },
        "runtime": {
          "workload_class": "runtime",
          "minimum_size": 0,
          "maximum_size": 3,
          "labels": {
            "fixture.platform.example/workload": "runtime"
          },
          "taints": [
            {
              "key": "fixture.platform.example/runtime",
              "value": "true",
              "effect": "NoSchedule"
            }
          ]
        }
      }
    },
    "postgres": {
      "engine_version": "fixture-version",
      "capacity_profile_ref": "ref://fixture/postgres-capacity",
      "high_availability": false,
      "backup_retention_days": 1,
      "logical_databases": [
        "control-plane",
        "usage",
        "billing",
        "audit"
      ],
      "encryption_key_ref": "ref://fixture/kms/postgres"
    },
    "redis": {
      "high_availability": false,
      "encryption_key_ref": "ref://fixture/kms/redis",
      "semantic_cache": {
        "enabled": false
      }
    },
    "kafka": {
      "encryption_key_ref": "ref://fixture/kms/kafka",
      "topics": {
        "fixture-usage": {
          "event_domain": "fixture-usage",
          "schema_version": 1,
          "partition_key_contract": "fixture-tenant-ordering",
          "retry_topic": "fixture-usage-retry",
          "dead_letter_topic": "fixture-usage-dlq"
        }
      }
    },
    "object_storage": {
      "stores": {
        "fixture-data": {
          "data_domain": "fixture-data",
          "purpose": "conformance-only",
          "versioning_enabled": true,
          "public_access_blocked": true,
          "encryption_key_ref": "ref://fixture/kms/object-storage"
        }
      }
    },
    "kms": {
      "key_purposes": [
        "envelope-encryption"
      ],
      "secret_manager_integration_ref": "ref://fixture/secret-manager-integration",
      "break_glass_workflow_ref": "ref://fixture/break-glass-workflow",
      "rotation_policy_ref": "ref://fixture/rotation-policy"
    },
    "dns": {
      "zones": {
        "fixture.invalid": {
          "purpose": "conformance-only",
          "visibility": "private"
        }
      }
    }
  }
}

