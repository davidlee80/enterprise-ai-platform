{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "旅行行程数据",
  "description": "AI 必须按此结构输出，不得返回 HTML、图片地址或图标地址。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trip",
    "content",
    "itinerary",
    "tips",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },

    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "startDate",
        "endDate",
        "days",
        "peopleCount"
      ],
      "properties": {
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "province": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": { "type": "integer", "minimum": 1, "maximum": 30 },
        "peopleCount": { "type": "integer", "minimum": 1 },
        "travelers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pace": { "type": "string" }
      }
    },

    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 18 },
        "subtitle": { "type": "string", "maxLength": 18 },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "itinerary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "theme",
          "summary",
          "estimatedCost",
          "color",
          "visualPosition"
        ],
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "theme": { "type": "string", "minLength": 1, "maxLength": 7 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 25 },
          "estimatedCost": { "type": "number", "minimum": 0 },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "visualTags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "visualPosition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 100 },
              "y": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },

    "tips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": {
            "enum": [
              "date",
              "transport",
              "walking",
              "reservation",
              "crowd",
              "environment"
            ]
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 30 }
        }
      }
    },

    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "items", "total"],
      "properties": {
        "currency": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "amount"],
            "properties": {
              "type": {
                "enum": ["ticket", "food", "transport", "other"]
              },
              "name": { "type": "string", "minLength": 1 },
              "amount": { "type": "number", "minimum": 0 }
            }
          }
        },
        "total": { "type": "number", "minimum": 0 },
        "excluded": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
