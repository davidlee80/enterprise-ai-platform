{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "海报生成请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["destination", "output"],
  "properties": {
    "destination": { "type": "string", "minLength": 1 },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "peopleCount": { "type": "integer", "minimum": 1 },
    "budget": { "type": "number", "minimum": 0 },

    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "travelers": { "type": "array", "items": { "type": "string" } },
        "ageGroup": { "type": "string" },
        "pace": { "type": "string" },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "visualPreferences": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio"],
      "properties": {
        "ratio": { "type": "string", "pattern": "^\\d+:\\d+$" },
        "format": { "enum": ["png"] },
        "language": { "type": "string" },
        "showBudget": { "type": "boolean" },
        "showRoute": { "type": "boolean" }
      }
    }
  }
}
